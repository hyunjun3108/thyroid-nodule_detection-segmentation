+class SegmentBRM(Segment):
+    """
+    YOLO Segment head with an auxiliary Boundary Refinement Module (BRM).
+
+    Identical to Segment at inference (zero added FLOPs). During training it adds a lightweight
+    branch on top of the prototype masks that predicts a single-channel semantic edge map, which
+    is supervised by a boundary-aware loss (see v8SegmentationBoundaryLoss). This guides prototype
+    features toward sharper nodule boundaries while keeping the inference graph unchanged.
+
+    Attributes:
+        bcv (nn.Sequential): Boundary branch producing a 1-channel edge map from the protos.
+
+    Examples:
+        >>> seg = SegmentBRM(nc=1, nm=32, npr=256, ch=(256, 512, 1024))
+        >>> outs = seg([torch.randn(1, 256, 80, 80), torch.randn(1, 512, 40, 40), torch.randn(1, 1024, 20, 20)])
+    """
+
+    def __init__(self, nc: int = 80, nm: int = 32, npr: int = 256, ch: Tuple = ()):
+        """Initialize SegmentBRM: base Segment head plus the auxiliary boundary branch."""
+        super().__init__(nc, nm, npr, ch)
+        # 프로토타입(nm ch) -> 1ch edge logits. 소형(train-only) 분기.
+        self.bcv = nn.Sequential(Conv(self.nm, 16, 3), nn.Conv2d(16, 1, 1))
+
+    def forward(self, x: List[torch.Tensor]) -> Union[Tuple, List[torch.Tensor]]:
+        """Same as Segment.forward, but also returns an edge map during training."""
+        p = self.proto(x[0])  # mask protos
+        bs = p.shape[0]  # batch size
+
+        mc = torch.cat([self.cv4[i](x[i]).view(bs, self.nm, -1) for i in range(self.nl)], 2)  # mask coefficients
+        x = Detect.forward(self, x)
+        if self.training:
+            edge = self.bcv(p)  # (bs, 1, mh, mw) edge logits — 학습 시에만 계산
+            return x, mc, p, edge
+        # eval/export 경로는 Segment 와 완전히 동일 (edge 미계산)
+        return (torch.cat([x, mc], 1), p) if self.export else (torch.cat([x[0], mc], 1), (x[1], mc, p))
+
